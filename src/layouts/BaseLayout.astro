---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | ${site.tagline}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// BASE_URL is '/' on the custom domain and '/<repo>/' on a GitHub Pages project URL.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (path: string) => `${base}${path}`;
const ogImage = new URL(asset('og-image.png'), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  slogan: site.tagline,
  description: site.description,
  areaServed: { '@type': 'AdministrativeArea', name: 'San Diego County, California' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" href={asset('llms.txt')} title="LLM-readable summary" />
    <meta name="theme-color" content="#f3f2ed" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-charcoal focus:px-4 focus:py-2 focus:text-bone"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
