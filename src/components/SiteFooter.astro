---
import Logo from './Logo.astro';
import { nav, site } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="bg-charcoal text-bone">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-12 lg:px-10">
    <div class="md:col-span-6">
      <Logo inverted />
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-sage">{site.tagline}</p>
    </div>
    <nav aria-label="Footer" class="md:col-span-3">
      <h2 class="label text-sage">Index</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((n) => (
          <li><a href={n.href} class="text-bone/80 hover:text-bone">{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="md:col-span-3">
      <h2 class="label text-sage">Contact</h2>
      <p class="mt-4 text-sm">
        <a href={`mailto:${site.email}`} class="text-bone/80 hover:text-bone">{site.email}</a>
      </p>
      <p class="mt-2 text-sm text-bone/80">San Diego County, California</p>
    </div>
  </div>
  <div class="border-t border-bone/15">
    <div class="label mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sage sm:flex-row sm:justify-between sm:px-6 lg:px-10">
      <p>© {year} {site.name}. {site.footerNote}</p>
      <p>{site.domain}</p>
    </div>
  </div>
</footer>
