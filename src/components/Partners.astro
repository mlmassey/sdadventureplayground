---
import Section from './ui/Section.astro';
import Icon from './ui/Icon.astro';
import Photo from './ui/Photo.astro';
import Button from './ui/Button.astro';
import { ArrowRight } from '@lucide/astro';
import { partner, mailto } from '../content/site';
---

<Section id="partner" index="05" eyebrow={partner.eyebrow} title={partner.title} tone="concrete">
  <div class="reveal grid gap-6 text-lg leading-relaxed text-steel md:grid-cols-2 md:gap-12">
    {partner.intro.map((p) => <p>{p}</p>)}
  </div>

  <h3 class="label mt-16 text-steel">{partner.fitsTitle}</h3>
  <ul class="mt-4 grid border-t border-l border-charcoal/80 md:grid-cols-2">
    {partner.fits.map((f) => (
      <li class="reveal flex flex-col border-r border-b border-charcoal/80 bg-bone p-6 sm:p-8">
        <Icon name={f.icon} size={28} class="text-moss" />
        <h4 class="mt-8 font-display text-xl font-bold sm:text-2xl">{f.title}</h4>
        <p class="mt-3 leading-relaxed text-steel">{f.text}</p>
      </li>
    ))}
  </ul>

  <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h3 class="label text-steel">{partner.lookingTitle}</h3>
      <ol class="mt-4 border-t border-charcoal">
        {partner.looking.map((l, i) => (
          <li class="reveal grid grid-cols-[2.5rem_1fr] gap-3 border-b border-line py-4">
            <span class="label pt-1 text-steel">0{i + 1}</span>
            <span class="leading-relaxed font-medium">{l}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg:col-span-5">
      <div class="reveal">
        <Photo id="workshop" sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
      <h3 class="label mt-10 text-steel">{partner.modelsTitle}</h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {partner.models.map((m) => (
          <li class="border border-charcoal px-3 py-1.5 text-sm font-medium">{m}</li>
        ))}
      </ul>
      <p class="mt-6 leading-relaxed text-steel">{partner.priority}</p>
      <Button href={mailto('Partnership inquiry: SD Adventure Playground')} class="mt-8">
        Start a conversation <ArrowRight size={16} aria-hidden="true" />
      </Button>
    </div>
  </div>
</Section>
