---
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import { Menu, X, ArrowRight } from '@lucide/astro';
import { nav, mailto, site } from '../content/site';
---

<header class="sticky top-0 z-50 border-b border-line bg-bone/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-10">
    <a href="#top" aria-label={`${site.name}, back to top`}>
      <Logo />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm font-medium text-steel transition-colors hover:text-charcoal">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Button href={mailto('Partnering with SD Adventure Playground')}>
          Partner with us <ArrowRight size={16} aria-hidden="true" />
        </Button>
      </div>

      <!-- Mobile menu: zero-JS <details> disclosure -->
      <details class="group relative lg:hidden">
        <summary
          class="grid h-11 w-11 cursor-pointer list-none place-items-center border border-charcoal [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Menu class="group-open:hidden" size={20} stroke-width={1.5} aria-hidden="true" />
          <X class="hidden group-open:block" size={20} stroke-width={1.5} aria-hidden="true" />
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-64 border border-charcoal bg-bone">
          <ul class="divide-y divide-line">
            {nav.map((item, i) => (
              <li>
                <a href={item.href} class="flex items-baseline gap-4 px-4 py-3.5 font-medium hover:bg-concrete">
                  <span class="label text-steel">0{i + 1}</span>{item.label}
                </a>
              </li>
            ))}
            <li>
              <a href={mailto('Partnering with SD Adventure Playground')} class="flex items-center justify-between bg-forest px-4 py-3.5 font-semibold text-bone">
                Partner with us <ArrowRight size={16} aria-hidden="true" />
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  // Tiny enhancement: close the mobile menu after choosing a link.
  document.addEventListener('click', (e) => {
    const link = e.target instanceof Element && e.target.closest('details[open] a');
    if (link) link.closest('details')?.removeAttribute('open');
  });
</script>
