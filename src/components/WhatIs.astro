---
import Section from './ui/Section.astro';
import Icon from './ui/Icon.astro';
import Photo from './ui/Photo.astro';
import { whatIs } from '../content/site';
---

<Section id="what" index="01" eyebrow={whatIs.eyebrow} title={whatIs.title}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="reveal lg:col-span-5">
      <Photo id="hands" sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>

    <div class="lg:col-span-7">
      <div class="reveal space-y-5 text-lg leading-relaxed text-steel">
        {whatIs.intro.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="label mt-12 text-steel">{whatIs.activitiesTitle}</h3>
      <ol class="mt-4 border-t border-charcoal">
        {whatIs.activities.map((a, i) => (
          <li class="reveal grid grid-cols-[2.5rem_1.75rem_1fr] items-start gap-3 border-b border-line py-4 sm:gap-4">
            <span class="label pt-1 text-steel">0{i + 1}</span>
            <Icon name={a.icon} class="mt-0.5 text-moss" />
            <p class="font-medium">{a.text}</p>
          </li>
        ))}
      </ol>

      <div class="reveal mt-10 border-l-2 border-moss bg-concrete p-6">
        <p class="label text-moss">{whatIs.supervisionTitle}</p>
        <p class="mt-2 leading-relaxed">{whatIs.supervision}</p>
      </div>
    </div>
  </div>
</Section>

<figure class="bg-forest text-bone">
  <div class="mx-auto grid max-w-7xl gap-6 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-12 lg:px-10">
    <div class="label text-sage lg:col-span-3">
      <span class="mb-4 block h-px w-12 bg-lichen" aria-hidden="true"></span>
      Principle
    </div>
    <blockquote class="reveal font-display text-3xl leading-[1.1] font-bold tracking-tight [font-stretch:112%] sm:text-5xl lg:col-span-9 lg:text-6xl">
      <p>{whatIs.quote}</p>
    </blockquote>
  </div>
</figure>
