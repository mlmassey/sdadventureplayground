---
import Section from './ui/Section.astro';
import Icon from './ui/Icon.astro';
import Photo from './ui/Photo.astro';
import { why } from '../content/site';
---

<Section id="why" index="02" eyebrow={why.eyebrow} title={why.title} tone="concrete">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="reveal space-y-5 text-lg leading-relaxed text-steel lg:col-span-5">
      {why.intro.map((p) => <p>{p}</p>)}
    </div>
    <ul class="border-t border-charcoal lg:col-span-7">
      {why.statements.map((s) => (
        <li class="reveal border-b border-line py-5 font-display text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
          {s}
        </li>
      ))}
    </ul>
  </div>

  <div class="reveal mt-16 sm:mt-20">
    <Photo id="teamwork" sizes="(min-width: 1280px) 1216px, 100vw" class="sm:aspect-[21/9]!" />
  </div>

  <div class="mt-16 sm:mt-20">
    <h3 class="label text-steel">{why.benefitsTitle}</h3>
    <ul class="mt-4 grid border-t border-l border-charcoal/80 sm:grid-cols-2 lg:grid-cols-5">
      {why.benefits.map((b, i) => (
        <li class="reveal flex flex-col border-r border-b border-charcoal/80 bg-bone p-6">
          <div class="flex items-center justify-between">
            <Icon name={b.icon} class="text-moss" size={26} />
            <span class="label text-steel">0{i + 1}</span>
          </div>
          <h4 class="mt-10 font-display text-lg leading-tight font-bold">{b.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-steel">{b.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <p class="reveal mt-16 max-w-3xl text-xl leading-relaxed font-medium">{why.closing}</p>
</Section>
