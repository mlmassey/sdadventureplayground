---
import Button from './ui/Button.astro';
import Photo from './ui/Photo.astro';
import { ArrowRight, ArrowDown } from '@lucide/astro';
import { hero, mailto } from '../content/site';
---

<section id="top" aria-labelledby="hero-heading" class="bg-bone">
  <div class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 sm:pt-20 lg:px-10 lg:pt-24">
    <p class="label flex items-center gap-3 text-steel">
      <span class="inline-block h-2 w-2 bg-moss" aria-hidden="true"></span>
      Proposed for San Diego County
    </p>

    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <h1 id="hero-heading" class="text-[2.6rem] leading-[0.98] font-extrabold sm:text-6xl lg:col-span-8 lg:text-[5.25rem]">
        {hero.title}
        <span class="block text-moss">{hero.titleAccent}</span>
      </h1>

      <div class="flex flex-col justify-end lg:col-span-4">
        <p class="text-lg leading-relaxed text-steel">{hero.lede}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <Button href={mailto(hero.primaryCta.subject)} size="lg">
            {hero.primaryCta.label}
            <ArrowRight size={18} aria-hidden="true" class="transition-transform group-hover:translate-x-0.5" />
          </Button>
          <Button href={hero.secondaryCta.href} variant="outline" size="lg">
            {hero.secondaryCta.label}
            <ArrowDown size={18} aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-14 max-w-7xl px-4 sm:mt-20 sm:px-6 lg:px-10">
    <Photo id="hero" eager sizes="(min-width: 1280px) 1216px, 100vw" />
    <p class="label mt-3 flex justify-between gap-4 text-steel">
      <span>{hero.eyebrow}</span>
      <span class="hidden sm:inline">Fig. 01</span>
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-4 pt-14 pb-20 sm:px-6 sm:pb-28 lg:px-10">
    <dl class="grid grid-cols-2 border-t border-l border-line lg:grid-cols-4">
      {hero.specs.map((s) => (
        <div class="flex flex-col gap-2 border-r border-b border-line p-4 sm:p-6">
          <dt class="label text-steel">{s.label}</dt>
          <dd class="font-display text-base font-semibold sm:text-xl">{s.value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-16 grid gap-8 lg:grid-cols-12">
      <p class="font-display text-2xl leading-snug font-medium sm:text-3xl lg:col-span-8">
        {hero.mission}
      </p>
      <div class="lg:col-span-4 lg:pt-2">
        <ul class="space-y-2 border-l-2 border-moss pl-5">
          {hero.points.map((p) => <li class="font-medium">{p}</li>)}
        </ul>
        <p class="mt-6 text-sm text-steel">{hero.seeking}</p>
      </div>
    </div>
  </div>
</section>
