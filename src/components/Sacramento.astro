---
import Section from './ui/Section.astro';
import Button from './ui/Button.astro';
import Photo from './ui/Photo.astro';
import { ArrowUpRight } from '@lucide/astro';
import { sacramento } from '../content/site';
---

<Section id="sacramento" index="03" eyebrow={sacramento.eyebrow} title={sacramento.title} tone="charcoal">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="reveal space-y-5 text-lg leading-relaxed text-sage lg:col-span-6">
      <p class="font-display text-2xl font-semibold text-bone">{sacramento.intro}</p>
      {sacramento.body.map((p) => <p>{p}</p>)}
      <p class="text-bone">{sacramento.goal}</p>
      <div class="pt-4">
        <Button href={sacramento.link.href} variant="outline-light">
          {sacramento.link.label}
          <ArrowUpRight size={18} aria-hidden="true" />
          <span class="sr-only">(opens in a new tab)</span>
        </Button>
      </div>
    </div>

    <div class="reveal lg:col-span-6">
      <Photo id="structures" dark sizes="(min-width: 1024px) 50vw, 100vw" />
      <p class="label mt-3 text-sage">Kids and the fort they built</p>
    </div>
  </div>

  <dl class="mt-16 grid border-t border-bone/25 sm:grid-cols-3">
    {sacramento.stats.map((s) => (
      <div class="reveal border-b border-bone/25 py-8 sm:border-r sm:border-b-0 sm:px-8 sm:first:pl-0 sm:last:border-r-0">
        <dt class="label text-sage">{s.label}</dt>
        <dd class="mt-3 font-display text-6xl leading-none font-bold tracking-tight [font-stretch:115%] sm:text-7xl">
          {s.value}
        </dd>
      </div>
    ))}
  </dl>

  <p class="reveal mt-16 max-w-4xl border-l-2 border-lichen pl-6 font-display text-2xl leading-snug font-semibold sm:text-3xl">
    {sacramento.proof}
  </p>
</Section>
